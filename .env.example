# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+asyncpg://app:changeme@postgres:5432/memorization

# ─── Backend ─────────────────────────────────────────────────────────────────
# Session/auth signing key. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts users.google_api_key_encrypted at rest (Fernet key).
# Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=

DEFAULT_GRADING_MODEL=gemma-4-e4b-it
ESCALATION_GRADING_MODEL=gemma-4-12b-it

# Comma-separated CORS origins for the frontend.
CORS_ORIGINS=http://localhost:5173

# Set to 0 to disable the in-process APScheduler (nightly FSRS refit, cache eviction).
ENABLE_BACKGROUND_JOBS=1

# §12 plugins. Empty = disabled (the safe default). Point it at a directory of
# .py files to load them at startup. Plugin code runs with the backend's full
# privileges, so enable this ONLY on an instance you alone operate — never on a
# shared/multi-tenant one. See backend/plugins.example/ and GET /api/plugins.
PLUGIN_DIR=

# §8.1 server-side URL fetching is an SSRF primitive (the user picks the URL,
# the server makes the request). Non-public destinations are blocked by default.
URL_FETCH_ENABLED=1
# Set to 1 only if you want the server to reach your own intranet.
URL_FETCH_ALLOW_PRIVATE=0

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# NOTE: there is deliberately no server-wide GOOGLE_API_KEY. Grading keys are
# per-user BYOK, stored encrypted in users.google_api_key_encrypted (§4.2).
